# Polaris developer harness configuration template. Startup copies this to
# .env (git-ignored) and fills the generated values; .env holds this
# machine's disposable values only. No production value belongs in either
# file.

COMPOSE_PROJECT_NAME=stratus-polaris-local

# Pinned Polaris release, live-validated 2026-08-03 (observed digest
# sha256:03a04f0459948da3977f7ea2ad2fb9ea672b2b503ec409c89c2934d400d71c67).
# The immutable digest pin with scan and SBOM evidence belongs to
# P1-2.2-S1. Never use latest.
POLARIS_IMAGE=apache/polaris:1.5.0

# Published on loopback only, like every harness port.
POLARIS_BIND_ADDRESS=127.0.0.1
POLARIS_PORT=8181

# Explicit disposable-development override: the scaffold serves plain HTTP on
# the loopback port until TLS wiring lands under P1-2.2-D1. Trusted-TLS
# termination for polaris.stratus.local is required before any shared or
# representative use.
POLARIS_ALLOW_HTTP=true

# Root principal bootstrap, verified against the live 1.5.0 image
# (Quarkus property polaris.bootstrap.credentials). Format:
# realm,client-id,client-secret. Startup generates the disposable secret;
# rotate after any real catalog bootstrap.
POLARIS_BOOTSTRAP_CREDENTIALS=POLARIS,stratus-root,

# Developer-only persistence, verified against the live 1.5.0 image
# (Quarkus property polaris.persistence.type): the in-memory metastore is
# explicitly test-only and loses all catalog state on restart. It can never
# satisfy the Increment 2 completion gate, backup/restore, HA, or recovery
# evidence. The persistent backend for this release line is relational-jdbc
# (PostgreSQL), owned by the production track (P1-2.1-P1).
POLARIS_PERSISTENCE_TYPE=in-memory

# Ceph RGW binding per ADR-P1-003. The endpoint,
# network name, and CA location are NOT set here: the harness scripts source
# them from the provider's connection.env so they exist in exactly
# one place. Only consumer-owned values belong below. The scoped svc-polaris
# RGW identity is created by the catalog bootstrap task (P1-2.3-D1); until
# then these stay empty and Iceberg location operations are unavailable.
CEPH_RGW_ACCESS_KEY=
CEPH_RGW_SECRET_KEY=
S3_PATH_STYLE_ACCESS=true
