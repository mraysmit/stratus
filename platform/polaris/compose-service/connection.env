# Connection settings engine harnesses need to reach this catalog
# (ADR-P1-003). Provider-owned shared configuration: these values are kept
# stable for consumers; everything not listed here (container names,
# internal addresses, the persistence backend) is private to this harness
# and may change without notice.
#
# Consumer harnesses source this file through their scripts and must never
# copy these values into their own scripts, Compose files, or templates —
# each consumer hardcodes exactly one value (this harness's repository
# path) and takes everything else from here.
#
# Values are non-secret by definition. Never add credentials, key paths
# under private/, or any per-machine value to this file. Principal
# credentials for an engine are published to the secret store, not here
# (ADR-P1-004).

# Compose project identity; must match COMPOSE_PROJECT_NAME in .env.template.
POLARIS_COMPOSE_PROJECT=stratus-polaris-local

# Iceberg REST catalog endpoint, TLS-terminated at this harness's proxy. The
# same URL works from containers attached to the Ceph harness network (Docker
# DNS alias) and, because the certificate also covers localhost and
# 127.0.0.1, from the workstation over loopback without a hosts-file entry.
POLARIS_ENDPOINT=https://polaris.stratus.local:8181
POLARIS_LOOPBACK_ENDPOINT=https://127.0.0.1:8181

# The catalog name engines bind to.
POLARIS_CATALOG=stratus

# CA certificate consumers mount read-only, relative to this directory.
# Issued by this harness on first startup; never a private key. This harness
# mints its own CA because the Ceph CA's signing key never crosses the
# harness boundary. A consumer talking to both Ceph RGW and this catalog
# trusts both CA certificates.
POLARIS_HARNESS_CA_CERT=certs/stratus-polaris-ca.crt
