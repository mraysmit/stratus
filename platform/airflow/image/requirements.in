# Stratus Airflow direct dependency intent.
#
# The provider versions are the known-compatible selections in Airflow 3.3.1's
# official Python 3.14 constraints. Stratus uses SparkSubmitOperator rather than
# Spark Connect or in-process PySpark, so the provider's lightweight mandatory
# pyspark-client dependency is installed without the optional 455 MB PySpark
# distribution. boto3 1.43.56 is the exact version in Airflow 3.3.1's official
# Python 3.14 constraint set. aiohttp is explicit because the upstream image's
# unused Ray bundle contains stale vendored 3.14.1 metadata; Ray is removed and
# the supported runtime is locked to the constraint's fixed 3.14.3 version.
# pyspark-client stays on the Spark 4.1 patch line and zstandard supplies its one
# dependency absent from the pinned Airflow base.
apache-airflow==3.3.1
apache-airflow-providers-apache-spark==6.3.1
apache-airflow-providers-amazon==9.34.0
boto3==1.43.56
aiohttp==3.14.3
pyspark-client==4.1.3
zstandard==0.25.0
