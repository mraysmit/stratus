# Airflow developer deployment. Startup copies this file to the git-ignored
# .env and generates every secret locally. Never place a production value here.

COMPOSE_PROJECT_NAME=stratus-airflow-local

# P1-4.1-S1 developer image and the approved PostgreSQL matrix entry.
AIRFLOW_IMAGE=stratus/airflow:dev
POSTGRES_IMAGE=postgres:17.10

# Loopback-only developer API publication.
AIRFLOW_BIND_ADDRESS=127.0.0.1
AIRFLOW_API_PORT=8088

# Generated by scripts/lifecycle/airflow-compose-startup.sh on first use.
AIRFLOW_DB_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=

# Health deadlines are operator-tunable without changing the deployment.
AIRFLOW_STARTUP_DEADLINE_SECONDS=180
