# Stratus Spark developer cluster configuration template. Startup copies this
# to .env (git-ignored) and fills the generated values; .env holds this
# machine's disposable values only. No production value belongs in either file.

COMPOSE_PROJECT_NAME=stratus-spark-local

# Runtime image built from platform/spark/image. Resolve its artifacts with
# scripts/lib/spark-compose-resolve-artifacts.sh, then run the docker build
# command that script prints. Never latest.
SPARK_IMAGE=stratus/spark-runtime:dev

# Published on loopback only, like every harness port. The master web UI moves
# off 8080 because the Ceph dashboard proxy already publishes there; the
# in-container ports remain the documented 8080/8081/7077.
SPARK_BIND_ADDRESS=127.0.0.1
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8090
SPARK_WORKER1_UI_PORT=8091
SPARK_WORKER2_UI_PORT=8092

# Reduced developer topology (P1-3.1-D1): two workers sized for a workstation.
# The approved production sizing belongs to P1-3.1-P1.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
# Default maximum for an application that does not declare spark.cores.max.
# The persistent verification client asks for one explicitly; packaged jobs
# may use two and therefore place one single-core executor on each worker.
SPARK_APPLICATION_CORES=2

# Polaris principal for this engine. The client id is fixed; startup generates
# the disposable secret and creates the principal through the catalog's
# management API. Rotate after any real use; never promote a harness
# credential.
SPARK_POLARIS_CLIENT_ID=svc-spark
SPARK_POLARIS_CLIENT_SECRET=

# Ceph RGW credentials are deliberately absent: the svc-spark key pair is
# pulled from the OpenBao secret store, where the Ceph provisioning step
# publishes it (ADR-P1-004). Nothing is copied by hand.
