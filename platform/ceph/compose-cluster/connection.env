# Connection settings other harnesses need to reach this cluster
# (ADR-P1-003). Provider-owned shared configuration: these values are kept
# stable for consumers; everything not listed here (container names,
# internal addresses, daemon topology) is private to this harness and may
# change without notice.
#
# Consumer harnesses source this file through their scripts and must never
# copy these values into their own scripts, Compose files, or templates —
# each consumer hardcodes exactly one value (this harness's repository
# path) and takes everything else from here. The guardrails in
# platform/ceph/tests enforce consistency with compose.yaml and the
# scripts; README.md describes the same values for humans.
#
# Values are non-secret by definition. Never add credentials, key paths
# under private/, or any per-machine value to this file.

# Compose project identity; must match the 'name:' field in compose.yaml.
CEPH_COMPOSE_PROJECT=stratus-ceph-local

# The Docker network consumers join (project name + the 'ceph' network key).
CEPH_HARNESS_NETWORK=stratus-ceph-local_ceph

# Endpoints, TLS-terminated at the harness proxy. The same URLs work from
# attached containers (Docker DNS alias) and from the workstation (hosts
# file to loopback).
CEPH_RGW_ENDPOINT=https://object-store.stratus.local:8443
CEPH_DASHBOARD_ENDPOINT=https://object-store.stratus.local:8444

# CA certificate consumers mount read-only, relative to this directory.
# Generated by the harness on first startup; never a private key.
CEPH_HARNESS_CA_CERT=certs/stratus-ca.crt
