# OpenBao developer harness configuration template. Startup copies this to
# .env (git-ignored) and fills the generated values; no production value
# belongs in either file.

COMPOSE_PROJECT_NAME=stratus-openbao-local

# Pinned OpenBao release, verified present on Docker Hub 2026-08-04. Never
# use latest.
OPENBAO_IMAGE=openbao/openbao:2.6.1

# Published on loopback only, like every harness port.
OPENBAO_BIND_ADDRESS=127.0.0.1
OPENBAO_PORT=8200

# Dev-mode root token; startup generates a disposable per-machine value and
# also writes it to private/root-token (owner-only) for consumer scripts.
# Dev mode serves plain HTTP on the loopback port — disposable development
# only; production posture (TLS, unseal, policies, audit) is owned by the
# production track per ADR-P1-004.
OPENBAO_ROOT_TOKEN=generated-at-first-startup
