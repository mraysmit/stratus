# Connection settings other harnesses need to reach the developer secret
# store (ADR-P1-004). Provider-owned shared configuration: consumers source
# this file through their scripts and hardcode only this harness's
# repository path; see the Ceph harness connection.env for the pattern.
#
# Values are non-secret by definition: the token FILE PATH is published
# here, its content never is. Do not add credentials or per-machine values.

# Dev-mode endpoint: plain HTTP on loopback only (disposable development;
# production requires TLS from the platform CA).
OPENBAO_ENDPOINT=http://127.0.0.1:8200

# Root token location, relative to this directory; created by startup with
# owner-only permissions. Consumers read the file, never this variable.
OPENBAO_TOKEN_FILE=private/root-token

# KV v2 mount and the base path where the Ceph provisioning step publishes
# platform service identities (secret/data/<path>/<uid> over the API).
OPENBAO_KV_MOUNT=secret
OPENBAO_SERVICE_IDENTITY_PATH=stratus/service-identities
