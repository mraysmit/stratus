<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.stratus</groupId>
    <artifactId>stratus-reactor</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Stratus Reactor</name>
    <description>Build reactor for the Stratus on-premises data platform</description>

    <properties>
        <test.groups></test.groups>
        <test.excludedGroups>ceph-integration | catalog-integration | secrets-integration | spark-integration</test.excludedGroups>
        <coverage.skip>false</coverage.skip>
        <ceph.integration.required>false</ceph.integration.required>
        <catalog.integration.required>false</catalog.integration.required>
        <secrets.integration.required>false</secrets.integration.required>
        <spark.integration.required>false</spark.integration.required>
    </properties>

    <modules>
        <module>build-support/stratus-bom</module>
        <module>build-support/stratus-build-parent</module>
        <module>verification/storage</module>
        <module>verification/catalog</module>
        <module>verification/secrets</module>
        <module>platform/ceph/tests</module>
        <module>platform/spark/aws-runtime</module>
        <module>platform/spark/tests</module>
        <module>jobs/spark</module>
        <module>testing/repo-guardrails</module>
    </modules>

    <profiles>
        <profile>
            <id>unit-tests</id>
            <properties>
                <test.groups>unit</test.groups>
                <test.excludedGroups>ceph-integration | catalog-integration | secrets-integration | spark-integration</test.excludedGroups>
                <coverage.skip>true</coverage.skip>
            </properties>
        </profile>
        <profile>
            <id>ceph-integration-tests</id>
            <properties>
                <test.groups>ceph-integration</test.groups>
                <test.excludedGroups></test.excludedGroups>
                <coverage.skip>true</coverage.skip>
                <ceph.integration.required>true</ceph.integration.required>
            </properties>
        </profile>
        <profile>
            <id>catalog-integration-tests</id>
            <properties>
                <test.groups>catalog-integration</test.groups>
                <test.excludedGroups></test.excludedGroups>
                <coverage.skip>true</coverage.skip>
                <catalog.integration.required>true</catalog.integration.required>
            </properties>
        </profile>
        <profile>
            <id>secrets-integration-tests</id>
            <properties>
                <test.groups>secrets-integration</test.groups>
                <test.excludedGroups></test.excludedGroups>
                <coverage.skip>true</coverage.skip>
                <secrets.integration.required>true</secrets.integration.required>
            </properties>
        </profile>
        <profile>
            <id>spark-integration-tests</id>
            <properties>
                <test.groups>spark-integration</test.groups>
                <test.excludedGroups></test.excludedGroups>
                <coverage.skip>true</coverage.skip>
                <spark.integration.required>true</spark.integration.required>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.4</version>
                        <configuration>
                            <!-- One reused JVM owns the live suite's single
                                 SparkContext. Each test class receives a fresh
                                 SparkSession with its own SQL configuration and
                                 catalog identity; JUnit's root store closes the
                                 context only after the complete suite. -->
                            <reuseForks>true</reuseForks>
                            <forkCount>1</forkCount>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>all-tests</id>
            <properties>
                <test.groups></test.groups>
                <test.excludedGroups></test.excludedGroups>
                <coverage.skip>false</coverage.skip>
                <ceph.integration.required>true</ceph.integration.required>
                <catalog.integration.required>true</catalog.integration.required>
                <secrets.integration.required>true</secrets.integration.required>
                <spark.integration.required>true</spark.integration.required>
            </properties>
        </profile>
        <profile>
            <id>untagged-tests</id>
            <properties>
                <test.groups></test.groups>
                <test.excludedGroups>unit | ceph-integration | catalog-integration | secrets-integration | spark-integration</test.excludedGroups>
                <coverage.skip>true</coverage.skip>
            </properties>
        </profile>
    </profiles>
</project>
